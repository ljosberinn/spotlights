<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<!-- Ours from the ground up. **Do not inherit CompactUnitFrameTemplate**: it put every spotlight
	     inside CompactUnitFrame.lua's shared module state, which taint.log named as the only place our
	     taint crossed onto Blizzard's own raid frames. PingableUnitFrameTemplate and
	     BasePrivateAuraBehaviorMixin are deliberately not inherited either. See
	     docs/notes/UnitFrameTemplate.md.

	     Script attributes take a *global* function name, which is why nothing of ours appears here:
	     the only global this addon defines is the mixin table. SecureUnitButtonTemplate supplies
	     OnClick -> SecureUnitButton_OnClick, which is what makes the *type1/*type2 attributes in
	     SlotHeader.InitChild work.

	     No frameStrata, deliberately: one declared here is set once per frame at creation and never
	     revisited. The strata is the container's now (position.strata), inherited down through the slot
	     header, so changing the setting restacks the spotlights already on screen. -->
	<Button name="SpotlightsUnitFrameTemplate" inherits="SecureUnitButtonTemplate" mixin="SpotlightsUnitFrameMixin" virtual="true">
		<Layers>
			<Layer level="BACKGROUND">
				<!-- White by design: UpdateHealthColor tints it to a fifth of the class colour. -->
				<Texture parentKey="background" atlas="raidframe-hp-bg-white" hWrapMode="REPEAT" vWrapMode="REPEAT" setAllPoints="true"/>
			</Layer>
			<Layer level="OVERLAY">
				<!-- OVERLAY rather than Blizzard's ARTWORK: the health bar is a child frame at the
				     parent's frame level, so its fill texture and an ARTWORK FontString here would
				     be a draw-order tie broken by creation order.

				     Anchored to both edges so the name uses the full frame width and
				     `wordwrap="false"` has one to truncate against. These offsets are only what a
				     frame shows before the appearance block lands: `NameStyle.ApplyLayout`
				     re-anchors the name from `nameX`/`nameY`, which default to them. -->
				<FontString parentKey="name" inherits="GameFontHighlightSmall" wordwrap="false" justifyH="LEFT">
					<Anchors>
						<Anchor point="TOPLEFT" x="3" y="-3"/>
						<Anchor point="TOPRIGHT" x="-3" y="-3"/>
					</Anchors>
				</FontString>
				<FontString parentKey="healthText" inherits="GameFontHighlightSmall" wordwrap="false" justifyH="CENTER">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="1">
				<!-- Starts at alpha 0 rather than hidden: UpdateSelectionHighlight drives it with
				     SetAlphaFromBoolean, because UnitIsUnit(unit, "target") may answer with a secret
				     and SetShown rejects one outright. A texture never hidden and never shown has no
				     state for a secret to leak through.

				     ignoreParentAlpha so the target outline stays opaque on a frame the range fade
				     has dimmed. -->
				<Texture parentKey="selectionHighlight" atlas="RaidFrame-TargetFrame" ignoreParentAlpha="true" setAllPoints="true" alpha="0"/>
			</Layer>
		</Layers>
		<Frames>
			<!-- Inset by one pixel on every side, which is what makes the background read as a border.
			     The absorb overlay is created against this bar in Lua because it has to mirror the
			     bar's orientation and fill direction. -->
			<StatusBar parentKey="healthBar" useParentLevel="true">
				<BarTexture atlas="RaidFrame-Hp-Fill" hWrapMode="REPEAT" vWrapMode="REPEAT" horizTile="true" vertTile="true"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="1" y="-1"/>
					<Anchor point="BOTTOMRIGHT" x="-1" y="1"/>
				</Anchors>
			</StatusBar>
			<!-- The unusable tail of the health bar under a temporary maximum-health loss. Spans the
			     same rectangle as the health bar and is revealed by pulling that bar's right edge in,
			     so the two never need to agree on a width. Reverse fill so the loss eats in from the
			     right to meet it, and a 0..1 scale because UpdateTempMaxHealthLoss drives this with a
			     *fraction* rather than the health bar's own scale. -->
			<StatusBar parentKey="tempMaxHealthLoss" hidden="true" drawLayer="ARTWORK" useParentLevel="true" fillStyle="Reverse" minValue="0" maxValue="1">
				<BarTexture atlas="_RaidFrame-Resource-Fill" hWrapMode="REPEAT" vWrapMode="REPEAT" horizTile="true" vertTile="true"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="1" y="-1"/>
					<Anchor point="BOTTOMRIGHT" x="-1" y="1"/>
				</Anchors>
			</StatusBar>
		</Frames>
		<Scripts>
			<!-- Mainline/UnitFrame.lua:380-387. Both read `self.unit`, which the attribute mirror owns,
			     and declaring them here does not disturb the OnClick inherited from
			     SecureUnitButtonTemplate. -->
			<OnEnter function="UnitFrame_OnEnter"/>
			<OnLeave function="UnitFrame_OnLeave"/>
		</Scripts>
	</Button>
</Ui>
